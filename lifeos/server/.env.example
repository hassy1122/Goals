# ---- Server ----
NODE_ENV=development
PORT=4000

# MongoDB (docker compose overrides this with mongodb://mongo:27017/lifeos)
MONGODB_URI=mongodb://127.0.0.1:27017/lifeos

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Cookies — in production with a separate API domain set COOKIE_SAMESITE=none AND COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_SECURE=false

# Frontend origin (CORS + links in emails)
CLIENT_URL=http://localhost:5173

# Email — leave SMTP_* empty in development (emails are printed to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional admin account bootstrapped by `npm run seed`
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Single owner account (private one-login LifeOS): sign-up is disabled and the
# seed provisions exactly this account. Real values belong in .env only.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_AUTH_MAX=5
